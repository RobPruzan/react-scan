{
  "name": "@react-scan/react-component-name-swc",
  "version": "0.1.0",
  "description": "SWC-based webpack plugin for injecting React component display names",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.mjs",
      "require": "./dist/webpack.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.mjs",
      "require": "./dist/loader.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "postbuild": "node ../../scripts/version-warning.mjs",
    "dev": "tsup --watch",
    "lint": "biome lint src && pnpm typecheck",
    "format": "biome format . --write",
    "check": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "rimraf dist && npm run build"
  },
  "keywords": [
    "react",
    "react-scan",
    "swc",
    "webpack",
    "displayname",
    "component-name"
  ],
  "author": {
    "name": "Team React Scan",
    "url": "https://github.com/aidenybai/react-scan"
  },
  "license": "MIT",
  "homepage": "https://github.com/aidenybai/react-scan",
  "bugs": {
    "url": "https://github.com/aidenybai/react-scan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aidenybai/react-scan.git"
  },
  "dependencies": {
    "@swc/core": "^1.7.0",
    "@rollup/pluginutils": "^5.1.3"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "latest",
    "webpack": "^5.0.0",
    "webpack-sources": "^3.2.3",
    "tsup": "^8.0.0",
    "rimraf": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE"]
}
