{
  "name": "react-component-name-swc",
  "version": "1.0.0",
  "description": "SWC-based webpack plugin for injecting React component display names",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.mjs",
      "require": "./dist/webpack.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "swc",
    "webpack",
    "component",
    "displayname",
    "transform"
  ],
  "author": "Devin AI",
  "license": "MIT",
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "dependencies": {
    "@swc/core": "^1.3.0",
    "@swc/types": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/webpack": "^5.28.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-sources": "^3.2.3"
  },
  "files": [
    "dist"
  ]
}
